@model BTL_PTTKHDT.Models.LoanDetailViewModel
@{
    string YesNo(bool value) => value ? "Có" : "Không";
    string Percent(decimal value) => value <= 0 ? "-" : $"{value * 100m:0.0}%";
    string PercentDouble(double? value) => value.HasValue ? $"{value.Value * 100d:0.0}%" : "-";
    var report = Model.ThamDinh;
}
@{
    string Vnd(decimal amount) =>
        amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " VNĐ";
    ViewData["Title"] = "Chi tiết đơn vay";
}

<div class="container-fluid loan-detail-page">
    <div class="d-flex align-items-start justify-content-between mb-2">
        <div>
            <h2 class="mb-1">@ViewData["Title"]</h2>
            <div class="text-secondary">Mã đơn: <span class="fw-semibold">@Model.Loan.MaDon</span></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Loan.MaDon" method="post" class="m-0"
                      onsubmit="return confirm('Xóa hồ sơ vay này? Thao tác này chỉ áp dụng khi hồ sơ chưa duyệt cấp 2/3 và chưa sinh khoản vay.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Xóa hồ sơ
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại</a>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-12">
            <div class="card p-3 loan-summary-card">
                <div class="loan-summary-grid">
                    <div class="loan-summary-item">
                        <div class="text-secondary small">Mã khách hàng</div>
                        <div class="fw-semibold">@Model.Loan.MaKh</div>
                    </div>
                    <div class="loan-summary-item">
                        <div class="text-secondary small">Tên khách hàng</div>
                        <div class="fw-semibold">@Model.Loan.TenKhachHang</div>
                    </div>

                    <div class="loan-summary-item">
                        <div class="text-secondary small">Loại khách hàng</div>
                        <div class="fw-semibold">@(Model.Loan.LoaiKhachHang == "business" ? "Doanh nghiệp" : "Cá nhân")</div>
                    </div>
                    <div class="loan-summary-item">
                        <div class="text-secondary small">Giấy tờ</div>
                        <div class="fw-semibold">@Model.Loan.NhanDangGiayTo @Model.Loan.SoGiayTo</div>
                    </div>

                    <div class="loan-summary-item">
                        <div class="text-secondary small">Số tiền yêu cầu</div>
                        <div class="fw-semibold">@Vnd(Model.Loan.SoTienYeuCau)</div>
                    </div>
                    <div class="loan-summary-item loan-summary-item-wide">
                        <div class="text-secondary small">Mục đích vay</div>
                        <div class="fw-semibold">@Model.Loan.MucDichVay</div>
                    </div>

                    <div class="loan-summary-item">
                        <div class="text-secondary small">Kỳ hạn đề nghị</div>
                        <div class="fw-semibold">@Model.KyHanDeNghi tháng</div>
                    </div>
                    <div class="loan-summary-item">
                        <div class="text-secondary small">Lãi suất đề nghị</div>
                        <div class="fw-semibold">@(Model.LaiSuatDeNghi.HasValue ? $"{Model.LaiSuatDeNghi:0.##}%" : "-")</div>
                    </div>
                    <div class="loan-summary-item">
                        <div class="text-secondary small">Ngày nộp đơn</div>
                        <div class="fw-semibold">@Model.NgayNopDon.ToString("dd/MM/yyyy")</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                    {
                        <div class="loan-summary-item loan-summary-item-wide">
                            <div class="text-secondary small mb-1">Ghi chú</div>
                            <div class="fw-semibold">@Model.GhiChu</div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    @if (TempData["CreditLimitError"] != null)
    {
        <div class="alert alert-danger mt-2 mb-0">@TempData["CreditLimitError"]</div>
    }
    @if (TempData["CreditLimitSuccess"] != null)
    {
        <div class="alert alert-success mt-2 mb-0">@TempData["CreditLimitSuccess"]</div>
    }

    <div class="card section-card p-3 mt-2 loan-appraisal-card">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
            <div>
                <div class="section-card-title">
                    <i class="bi bi-clipboard2-check"></i>
                    <span>Báo cáo thẩm định trước khi cho vay</span>
                </div>
                <div class="text-secondary small">Bảng kiểm tra nhanh để cán bộ tín dụng và người phê duyệt xem trước khi ra quyết định.</div>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                <span class="status-chip @(report.DeXuatChoVay ? "status-chip-success" : "status-chip-warning")">
                    @(report.DeXuatChoVay ? "Đề xuất có thể cho vay" : "Cần xem xét thêm")
                </span>
                <a asp-action="AppraisalPdf" asp-route-id="@Model.Loan.MaDon" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-filetype-pdf me-1"></i> Xuất PDF
                </a>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-lg-4">
                <div class="soft-panel p-3 loan-appraisal-panel">
                    <div class="fw-semibold mb-2">I. Thông tin và tư cách khách hàng</div>
                    <div class="small text-secondary">Mã KH</div>
                    <div class="fw-semibold mb-2">@report.MaKh</div>
                    <div class="small text-secondary">Họ tên / Ten DN</div>
                    <div class="fw-semibold mb-2">@report.HoTen</div>
                    <div class="small text-secondary">Loại khách hàng</div>
                    <div class="fw-semibold mb-2">@report.LoaiKhachHang</div>
                    <div class="small text-secondary">CMND/CCCD</div>
                    <div class="fw-semibold mb-2">@report.CmndCccd</div>
                    <div class="small text-secondary">Địa chỉ</div>
                    <div class="fw-semibold mb-2">@(string.IsNullOrWhiteSpace(report.DiaChi) ? "-" : report.DiaChi)</div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="status-chip @(report.DuTuCachVayVon ? "status-chip-success" : "status-chip-warning")">Đủ tư cách: @YesNo(report.DuTuCachVayVon)</span>
                        <span class="status-chip status-chip-info">Mục đích hợp pháp: @YesNo(report.MucDichHopPhap)</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="soft-panel p-3 loan-appraisal-panel">
                    <div class="fw-semibold mb-2">II. Tài chính và lịch sử tín dụng</div>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="small text-secondary">Điểm tín dụng</div>
                            <div class="h4 mb-0">@(report.DiemTinDung?.ToString() ?? "Chưa có")</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary">Xếp hạng</div>
                            <div class="h4 mb-0">@(report.XepHangRuiRo ?? "Chưa có")</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary">Số lần trả trễ</div>
                            <div class="fw-semibold">@report.SoLanTraTre</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary">Nợ / thu nhập</div>
                            <div class="fw-semibold">@PercentDouble(report.TyLeNoThuNhap)</div>
                        </div>
                        <div class="col-12">
                            <div class="small text-secondary">Dư nợ gốc hiện tại</div>
                            <div class="fw-semibold">@Vnd(report.TongDuNoGocHienTai)</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary">Nhóm nợ cao nhất</div>
                            @if (Model.Loan.LoaiKhachHang != "business")
                            {
                                <div class="small text-secondary mt-2">Nghề nghiệp</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(report.NgheNghiep) ? "-" : report.NgheNghiep)</div>
                                <div class="small text-secondary mt-2">Thu nhập tháng</div>
                                <div class="fw-semibold">@(report.ThuNhapHangThang.HasValue ? Vnd(report.ThuNhapHangThang.Value) : "-")</div>
                            }
                            <div class="fw-semibold">Nhom @report.NhomNoCaoNhat</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary">Nợ xấu</div>
                            <div class="fw-semibold">@YesNo(report.CoNoXau)</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <span class="status-chip @(report.CoKhaNangTaiChinh ? "status-chip-success" : "status-chip-warning")">Tài chính: @YesNo(report.CoKhaNangTaiChinh)</span>
                        <span class="status-chip @(report.CoNoQuaHan ? "status-chip-warning" : "status-chip-success")">Quá hạn: @YesNo(report.CoNoQuaHan)</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="soft-panel p-3 loan-appraisal-panel">
                    <div class="fw-semibold mb-2">III. Nhu cầu vay và tài sản bảo đảm</div>
                    <div class="small text-secondary">Mục đích vay</div>
                    <div class="fw-semibold mb-2">@Model.Loan.MucDichVay</div>
                    <div class="small text-secondary">Số tiền de nghi vay</div>
                    <div class="fw-semibold mb-2">@Vnd(report.SoTienYeuCau)</div>
                    <div class="small text-secondary">Tổng giá trị TSĐB</div>
                    <div class="fw-semibold mb-2">@Vnd(report.TongGiaTriDamBao)</div>
                    <div class="small text-secondary">Hạn mức tối đa đã cấp</div>
                    <div class="fw-semibold mb-2">@(report.HanMucToiDa.HasValue ? Vnd(report.HanMucToiDa.Value) : "Chưa cấp")</div>
                    @if (!report.HanMucToiDa.HasValue)
                    {
                        <div class="loan-limit-note mb-2">
                            Chưa có hạn mức tín dụng riêng cho khách hàng này; hồ sơ đang xét theo tài sản bảo đảm và LTV.
                        </div>
                    }
                    <div class="small text-secondary">Cấp/Cập nhật hạn mức tối đa</div>
                    <form asp-controller="Customer" asp-action="UpdateCreditLimit" asp-route-id="@report.MaKh" method="post" class="loan-credit-limit-form mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <div class="input-group input-group-sm">
                            <input id="loanCreditLimit"
                                   name="hanMucToiDa"
                                   class="form-control"
                                   inputmode="numeric"
                                   value="@(TempData["CreditLimitInput"] as string ?? report.HanMucToiDa?.ToString("N0"))"
                                   placeholder="Ví dụ: 100.000.000" />
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-check2"></i>
                            </button>
                        </div>
                    </form>
                    <div class="small text-secondary">Hạn mức đã sử dụng</div>
                    <div class="fw-semibold mb-2">@(report.HanMucDaSuDung.HasValue ? Vnd(report.HanMucDaSuDung.Value) : "-")</div>
                    <div class="small text-secondary">Hạn mức còn lại trước khi xét đơn</div>
                    <div class="fw-semibold mb-2">@(report.HanMucConLai.HasValue ? Vnd(report.HanMucConLai.Value) : "-")</div>
                    <div class="small text-secondary">Hạn mức gợi ý theo LTV</div>
                    <div class="fw-semibold mb-2">@Vnd(report.HanMucGoiY)</div>
                    <div class="small text-secondary">Số tiền có thể vay thêm</div>
                    <div class="fw-semibold mb-2">@(report.HanMucChoVayKhaDung.HasValue ? Vnd(report.HanMucChoVayKhaDung.Value) : "-")</div>
                    <div class="small text-secondary">LTV yêu cầu / TSĐB</div>
                    <div class="fw-semibold mb-2">@Percent(report.TyLeLtv)</div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="status-chip @(report.DuDieuKienDamBao ? "status-chip-success" : "status-chip-warning")">Đảm bảo nợ vay: @YesNo(report.DuDieuKienDamBao)</span>
                        <span class="status-chip @(report.DuDieuKienHanMuc ? "status-chip-success" : "status-chip-warning")">Có thể vay thêm: @YesNo(report.DuDieuKienHanMuc)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.TaiSanDamBao.Count > 0)
        {
            <div class="table-responsive mt-2">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã TS</th>
                            <th>Loại tài sản</th>
                            <th class="text-end">Định giá</th>
                            <th class="text-center">LTV</th>
                            <th>Giấy tờ pháp lý</th>
                            <th class="text-center">Sở hữu</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ts in Model.TaiSanDamBao)
                    {
                        <tr>
                            <td class="fw-semibold">@ts.MaTaiSanKh</td>
                            <td>@ts.LoaiTaiSan</td>
                            <td class="text-end">@(ts.GiaTriDinhGia.HasValue ? Vnd(ts.GiaTriDinhGia.Value) : Vnd(ts.GiaTriKhaiBao))</td>
                            <td class="text-center">@($"{ts.TyLeLtv * 100:0.#}%")</td>
                            <td>@(string.IsNullOrWhiteSpace(ts.GiayToPhapLy) ? "-" : ts.GiayToPhapLy)</td>
                            <td class="text-center"><span class="status-chip status-chip-success">@ts.TrangThaiSoHuu</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="row g-2 mt-2">
        <div class="col-lg-7">
            <div class="card p-3 loan-work-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-semibold">Tài sản đảm bảo</div>
                </div>

                @if (TempData["CollateralError"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["CollateralError"]</div>
                }
                @if (TempData["CollateralSuccess"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["CollateralSuccess"]</div>
                }

                <form asp-action="AddCollateral" asp-route-id="@Model.Loan.MaDon" method="post" class="border rounded-3 p-2 mb-2 collateral-create-form">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label small text-secondary mb-1">Loại tài sản</label>
                            <input name="LoaiTaiSan" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label small text-secondary mb-1">Giá trị khai báo</label>
                            <input name="GiaTriKhaiBao" class="form-control form-control-sm" inputmode="numeric" />
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <label class="form-label small text-secondary mb-1">Tỷ lệ LTV</label>
                            <input name="TyLeLtv" class="form-control form-control-sm" value="0.7" inputmode="decimal" />
                        </div>
                        <div class="col-6 col-md-8 col-xl-3 d-flex align-items-end">
                            <button class="btn btn-sm btn-primary w-100" type="submit">Thêm tài sản</button>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label small text-secondary mb-1">Giấy tờ pháp lý</label>
                            <input name="GiayToPhapLy" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label small text-secondary mb-1">Mô tả</label>
                            <input name="MoTa" class="form-control form-control-sm" />
                        </div>
                    </div>
                </form>

                @if (Model.TaiSanDamBao.Count == 0)
                {
                    <div class="text-secondary">Chưa có tài sản đảm bảo.</div>
                }
                else
                {
                    <div class="table-responsive collateral-table-wrap">
                        <table class="table table-sm align-middle mb-0 collateral-table">
                            <thead>
                                <tr class="text-secondary small">
                                    <th>Mã</th>
                                    <th>Loại</th>
                                    <th class="text-end">Khai báo</th>
                                    <th class="text-end">Định giá</th>
                                    <th class="text-center">LTV</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-end collateral-action-heading">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ts in Model.TaiSanDamBao)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ts.MaTaiSanKh</td>
                                        <td>
                                            <div class="fw-semibold">@ts.LoaiTaiSan</div>
                                            @if (!string.IsNullOrWhiteSpace(ts.MoTa))
                                            {
                                                <div class="text-secondary small">@ts.MoTa</div>
                                            }
                                        </td>
                                        <td class="text-end">@Vnd(ts.GiaTriKhaiBao)</td>
                                        <td class="text-end">@(ts.GiaTriDinhGia.HasValue ? Vnd(ts.GiaTriDinhGia.Value) : "-")</td>
                                        <td class="text-center">@($"{ts.TyLeLtv * 100:0.#}%")</td>
                                        <td class="text-center collateral-status-cell">
                                            <span class="badge text-bg-light collateral-status-badge">@ts.TrangThai</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="collateral-actions">
                                            <form asp-action="ValuateCollateral" asp-route-id="@Model.Loan.MaDon" method="post" class="collateral-valuation-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="MaTaiSanKh" value="@ts.MaTaiSanKh" />
                                                <input name="GiaTriDinhGia" class="form-control form-control-sm collateral-valuation-input" placeholder="Định giá" inputmode="numeric" />
                                                <button class="btn btn-sm btn-outline-primary collateral-icon-btn collateral-save-btn" type="submit" title="Lưu định giá" aria-label="Lưu định giá">Định giá</button>
                                            </form>
                                            <div class="collateral-icon-group">
                                                <button type="button" class="btn btn-sm btn-outline-secondary collateral-icon-btn" data-bs-toggle="modal" data-bs-target="#edit-collateral-@ts.MaTaiSanKh" title="Sửa tài sản" aria-label="Sửa tài sản">
                                                    Sửa
                                                </button>
                                                <form asp-action="DeleteCollateral" asp-route-id="@Model.Loan.MaDon" asp-route-maTaiSanKh="@ts.MaTaiSanKh" method="post" onsubmit="return confirm('Xóa tài sản này khỏi hồ sơ?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-sm btn-outline-danger collateral-icon-btn collateral-delete-btn" type="submit" title="Xóa tài sản" aria-label="Xóa tài sản">Xóa</button>
                                                </form>
                                            </div>
                                            </div>

                                            <div class="modal fade" id="edit-collateral-@ts.MaTaiSanKh" tabindex="-1" aria-labelledby="edit-collateral-label-@ts.MaTaiSanKh" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content text-start">
                                                        <form asp-action="EditCollateral" asp-route-id="@Model.Loan.MaDon" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="MaTaiSanKh" value="@ts.MaTaiSanKh" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="edit-collateral-label-@ts.MaTaiSanKh">Sửa tài sản @ts.MaTaiSanKh</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label">Loại tài sản</label>
                                                                        <input name="LoaiTaiSan" class="form-control" value="@ts.LoaiTaiSan" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label">Giá trị khai báo</label>
                                                                        <input name="GiaTriKhaiBao" class="form-control" value="@ts.GiaTriKhaiBao.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" inputmode="numeric" />
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label">Tỷ lệ LTV</label>
                                                                        <input name="TyLeLtv" class="form-control" value="@ts.TyLeLtv.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" inputmode="decimal" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label">Giấy tờ pháp lý</label>
                                                                        <input name="GiayToPhapLy" class="form-control" value="@ts.GiayToPhapLy" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label">Mô tả</label>
                                                                        <input name="MoTa" class="form-control" value="@ts.MoTa" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-3 loan-work-card">
                <div class="fw-semibold mb-2">Phê duyệt (Tạo đơn → Kiểm tra → Phê duyệt)</div>

                <div class="d-flex flex-column gap-2">
                    @foreach (var step in Model.PheDuyet.OrderBy(x => x.CapPheDuyet))
                    {
                        <div class="border rounded-3 p-3 loan-approval-step">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">@step.CapText</div>
                                    <div class="text-secondary small">Trạng thái: <span class="fw-semibold">@step.TrangThai</span></div>
                                    @if (!string.IsNullOrWhiteSpace(step.MaNv))
                                    {
                                        <div class="text-secondary small">Nhân viên: <span class="fw-semibold">@step.MaNv</span></div>
                                    }
                                    @if (step.NgayXuLy.HasValue)
                                    {
                                        <div class="text-secondary small">Ngày xử lý: <span class="fw-semibold">@step.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm")</span></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(step.GhiChu))
                                    {
                                        <div class="text-secondary small">Ghi chú: <span class="fw-semibold">@step.GhiChu</span></div>
                                    }
                                </div>
                                <div class="text-end">
                                    @{
                                        var canApprove = step.CapPheDuyet == 1 ? Model.Loan.TrangThaiMaker == "pending"
                                            : step.CapPheDuyet == 2 ? Model.Loan.TrangThaiChecker == "pending"
                                            : Model.Loan.TrangThaiApprover == "pending";
                                    }
                                    @if (canApprove)
                                    {
                                        <form asp-action="Decide" method="post" class="d-flex flex-column gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Loan.MaDon" />
                                            <input type="hidden" name="cap" value="@step.CapPheDuyet" />
                                            <input name="note" class="form-control form-control-sm" placeholder="Ghi chú..." />
                                            <div class="d-flex gap-2 justify-content-end">
                                                <button class="btn btn-sm btn-outline-danger" type="submit" name="decision" value="reject">Từ chối</button>
                                                <button class="btn btn-sm btn-primary" type="submit" name="decision" value="approve">Duyệt</button>
                                            </div>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

