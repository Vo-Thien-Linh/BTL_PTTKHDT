@model IReadOnlyList<BTL_PTTKHDT.Models.DebtLoanRowViewModel>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Quản lý nợ";
    var q = (ViewData["Query"] as string) ?? string.Empty;
    var page = (int)(ViewData["Page"] ?? 1);
    var pageSize = (int)(ViewData["PageSize"] ?? 10);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var totalPages = totalCount <= 0 ? 1 : (int)Math.Ceiling((double)totalCount / pageSize);
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">@ViewData["Title"]</h2>
            <div class="text-secondary">Tổng: <span class="fw-semibold">@totalCount</span> khoản vay</div>
        </div>

        <form method="get" class="d-flex gap-2" data-auto-filter>
            <input class="form-control form-control-sm" style="min-width: 260px" name="q" value="@q" placeholder="Tìm mã vay / mã đơn / khách hàng..." />
        </form>
    </div>

    <div class="card p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle debt-table">
                <thead class="table-light">
                    <tr>
                        <th>Mã vay</th>
                        <th>Khách hàng</th>
                        <th class="text-end">Dư nợ gốc</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary p-4">Chưa có khoản vay.</td>
                    </tr>
                }
                else
                {
                    var rowIndex = 0;
                    foreach (var item in Model)
                    {
                        rowIndex++;
                        var detailId = $"debt-row-{rowIndex}";
                        <tr>
                            <td class="fw-semibold">@item.MaVay</td>
                            <td>
                                <div class="fw-semibold">@item.TenKhachHang</div>
                                <div class="text-secondary small">@item.MaKh</div>
                            </td>
                            <td class="text-end">@item.DuNoGoc.ToString("N0")</td>
                            <td><span class="badge text-bg-light">@item.TrangThai</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId" aria-expanded="false" aria-controls="@detailId">
                                    Thông tin
                                </button>
                                <a asp-action="Details" asp-route-id="@item.MaVay" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            </td>
                        </tr>
                        <tr class="collapse" id="@detailId">
                            <td colspan="5" class="bg-light">
                                <div class="debt-row-detail">
                                    <div>
                                        <div class="text-secondary small">Mã đơn</div>
                                        <div class="fw-semibold">@item.MaDon</div>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Số tiền vay</div>
                                        <div class="fw-semibold">@item.SoTienVay.ToString("N0")</div>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Kỳ hạn</div>
                                        <div class="fw-semibold">@item.KyHan tháng</div>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Lãi suất</div>
                                        <div class="fw-semibold">@($"{item.LaiSuat:0.##}%")</div>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Giải ngân</div>
                                        <div class="fw-semibold">@item.NgayGiaiNgan.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-end mt-3">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?q=@q&page=@(page-1)">Trước</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@($"{page} / {totalPages}")</span></li>
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="?q=@q&page=@(page+1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<style>
    .debt-table .btn + .btn {
        margin-left: 4px;
    }

    .debt-row-detail {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 12px;
        padding: 10px 4px;
    }

    @@media (max-width: 992px) {
        .debt-row-detail {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }
    }
</style>
