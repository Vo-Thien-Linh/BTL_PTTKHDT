@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Hệ thống Tín dụng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-panel">
            <div class="login-brand">
                <div class="login-brand-mark">
                    <i class="bi bi-bank"></i>
                </div>
                <div>
                    <div class="login-title">Hệ thống Tín dụng</div>
                    <div class="login-subtitle">Đăng nhập quản trị</div>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                @if (errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 mb-3" role="alert">
                        @foreach (var error in errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                @if (TempData["LoginMessage"] is string loginMessage)
                {
                    <div class="alert alert-success py-2 mb-3" role="alert">@loginMessage</div>
                }

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                </div>

                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Đăng nhập
                </button>
            </form>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
