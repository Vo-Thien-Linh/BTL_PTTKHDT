@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Hệ thống Tín dụng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-frame" aria-label="Đăng nhập hệ thống tín dụng">
            <aside class="login-intro" aria-hidden="true">
                <div class="login-intro-brand">
                    <div class="login-brand-mark login-brand-mark--light">
                        <i class="bi bi-bank2" aria-hidden="true"></i>
                    </div>
                    <span>Hệ thống Tín dụng</span>
                </div>

                <div class="login-intro-copy">
                    <h1 class="login-intro-title login-intro-title--hero">Chào mừng</h1>
                    <h1 class="login-intro-title login-intro-title--sub">bạn trở lại</h1>
                    <p>Trải nghiệm dịch vụ tài chính an toàn, tiện lợi và nhanh chóng. Chúng tôi luôn đồng hành cùng sự phát triển của bạn.</p>
                </div>

                <div class="login-security-badge">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>BẢO MẬT CẤP ĐỘ NGÂN HÀNG</span>
                </div>
            </aside>

            <section class="login-panel">
                <div class="login-form-heading">
                    <div class="login-brand-mark d-lg-none">
                        <i class="bi bi-bank2" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2>Đăng nhập</h2>
                        <p>Nhập thông tin để tiếp tục</p>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" class="login-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    @if (errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 mb-3" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (TempData["LoginMessage"] is string loginMessage)
                    {
                        <div class="alert alert-success py-2 mb-3" role="alert">@loginMessage</div>
                    }

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <div class="input-group login-input-group">
                            <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus placeholder="Nhập tên đăng nhập" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <div class="input-group login-input-group">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu" />
                            <button class="btn btn-outline-secondary login-password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="login-forgot-link">Quên mật khẩu?</a>
                    </div>

                    <button class="btn btn-primary login-submit w-100" type="submit">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>
                        Đăng nhập
                    </button>

                    <hr class="my-4" />
                    <div class="text-center small text-muted">
                        Chưa có tài khoản?
                        <span class="fw-semibold">Liên hệ quản trị viên</span>
                    </div>
                </form>
            </section>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            var input = document.getElementById('MatKhau');
            var toggle = document.querySelector('.login-password-toggle');
            if (!input || !toggle) return;

            toggle.addEventListener('click', function () {
                var isPassword = input.getAttribute('type') !== 'text';
                input.setAttribute('type', isPassword ? 'text' : 'password');
                toggle.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                toggle.setAttribute('aria-label', isPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');

                var icon = toggle.querySelector('i');
                if (icon) {
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                }
            });
        })();
    </script>
</body>
</html>
