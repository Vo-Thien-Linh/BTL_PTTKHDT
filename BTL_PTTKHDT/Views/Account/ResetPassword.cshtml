@model ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - Hệ thống Tín dụng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-panel">
            <div class="login-brand">
                <div>
                    <div class="login-title">Đặt lại mật khẩu</div>
                    <div class="login-subtitle">Nhập mã 6 số đã gửi qua Gmail</div>
                </div>
            </div>

            @if (TempData["ForgotPasswordMessage"] is string message)
            {
                <div class="alert alert-success py-2 mb-3">@message</div>
            }

            <form asp-controller="Account" asp-action="ResetPassword" method="post" class="login-form" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="MaTaiKhoan" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button class="btn btn-primary w-100" type="submit">Đặt lại mật khẩu</button>
                <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-link w-100 mt-2">Gửi lại mã</a>
            </form>
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
