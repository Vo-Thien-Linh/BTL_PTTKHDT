@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - Hệ thống Tín dụng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-panel">
            <div class="login-brand">
                <div>
                    <div class="login-title">Quên mật khẩu</div>
                    <div class="login-subtitle">Nhận mã xác nhận qua Gmail</div>
                </div>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="login-form" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="LoginOrEmail" class="form-label"></label>
                    <input asp-for="LoginOrEmail" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="LoginOrEmail" class="text-danger small"></span>
                </div>

                <button class="btn btn-primary w-100" type="submit">Gửi mã xác nhận</button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-link w-100 mt-2">Quay lại đăng nhập</a>
            </form>
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
