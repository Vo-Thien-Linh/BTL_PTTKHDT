@model BTL_PTTKHDT.Models.DisbursementListViewModel
@{
    ViewData["Title"] = "Giải ngân";
    string Vnd(decimal amount) => amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " VND";
}

<div class="container-fluid">
    <div class="page-hero mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="page-hero-title">Giải ngân</h2>
                <div class="page-hero-subtitle small">Danh sách hồ sơ đã duyệt, chưa tạo khoản vay. Kiểm tra lần cuối trước khi giải ngân.</div>
            </div>
            <span class="status-chip status-chip-info">@Model.TotalCount hồ sơ chờ giải ngân</span>
        </div>
    </div>

    <form method="get" class="d-flex align-items-center gap-2 mb-3 flex-wrap" data-auto-filter>
        <div class="input-group input-group-sm" style="width: min(360px, 100%);">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input name="q" value="@Model.Query" class="form-control" placeholder="Tìm mã đơn / khách hàng / mục đích..." />
        </div>
        <div class="text-secondary small ms-auto">Hiển thị @Model.From-@Model.To của @Model.TotalCount hồ sơ</div>
    </form>

    <div class="card section-card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Mục đích vay</th>
                        <th class="text-end">Số tiền</th>
                        <th class="text-end">TSDB</th>
                        <th class="text-end">Hạn mức gợi ý</th>
                        <th class="text-end">Có thể giải ngân</th>
                        <th class="text-center">Điều kiện</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary p-4">Không có hồ sơ nào đang chờ giải ngân.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.MaDon</td>
                            <td>
                                <div class="fw-semibold">@item.TenKhachHang</div>
                                <div class="text-secondary small">@item.MaKh</div>
                            </td>
                            <td>@item.MucDichVay</td>
                            <td class="text-end fw-semibold">@Vnd(item.SoTienYeuCau)</td>
                            <td class="text-end">@Vnd(item.TongGiaTriDamBao)</td>
                            <td class="text-end">@Vnd(item.HanMucGoiY)</td>
                            <td class="text-end fw-semibold">@Vnd(item.SoTienCoTheGiaiNgan)</td>
                            <td class="text-center">
                                <span class="status-chip @(item.DaDuDieuKienTaiSan && item.DaDuDieuKienHanMuc ? "status-chip-success" : "status-chip-warning")">
                                    @(item.DaDuDieuKienTaiSan && item.DaDuDieuKienHanMuc ? "Đạt" : "Chưa đạt")
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.MaDon" class="btn btn-sm btn-primary">Kiểm tra</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">
            <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
               asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Trước</a>
            <span class="btn btn-sm btn-light disabled">@Model.Page / @Model.TotalPages</span>
            <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
               asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Sau</a>
        </div>
    }
</div>
