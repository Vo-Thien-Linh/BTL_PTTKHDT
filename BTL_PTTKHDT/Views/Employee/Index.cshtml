@model IEnumerable<BTL_PTTKHDT.Models.NhanVien>
@{ ViewData["Title"] = "Quản lý Nhân sự"; }
<div class='container-fluid'>
    <div class='d-flex justify-content-between align-items-center mb-4'>
        <h2>Quản lý Nhân sự</h2>
        <a asp-action='Create' class='btn btn-primary'>
            <i class='bi bi-plus-lg me-1'></i>+ Thêm nhân viên
        </a>
    </div>
    <div class='card mb-3'>
        <div class='card-body'>
            <form method='get' class='d-flex gap-2' style='max-width:400px'>
                <input type='text' name='q' value='@ViewBag.Query' class='form-control' placeholder='Tìm kiếm theo mã, họ tên, SDT...' />
                <button class='btn btn-outline-secondary' type='submit'>
                    <i class='bi bi-search'></i> Tìm
                </button>
            </form>
        </div>
    </div>

    <div class='card'>
        <div class='card-body p-0'>
            @if (!Model.Any())
            {
                <div class='text-center text-secondary py-5'>
                    <i class='bi bi-inbox' style='font-size: 3rem; opacity: 0.5;'></i>
                    <p class='mt-3 mb-0'>Không có nhân viên nào.</p>
                </div>
            }
            else
            {
                <div class='row g-3 p-4'>
                    @foreach(var item in Model) {
                        <div class='col-12 col-sm-6 col-lg-4 col-xl-3'>
                            <div class='card h-100 border-0 shadow-sm hover-card'>
                                <!-- Avatar Section -->
                                <div class='position-relative bg-light' style='height: 180px; border-radius: 8px 8px 0 0; overflow: hidden;'>
                                    @if (!string.IsNullOrWhiteSpace(item.AnhDaiDienUrl))
                                    {
                                        <img src='@item.AnhDaiDienUrl' alt='@item.HoTen' class='w-100 h-100' style='object-fit: cover;'>
                                    }
                                    else
                                    {
                                        <div class='w-100 h-100 d-flex align-items-center justify-content-center bg-gradient'>
                                            <i class='bi bi-person-circle' style='font-size: 4rem; color: #d9d9d9;'></i>
                                        </div>
                                    }
                                    <!-- Status Badge -->
                                    <div class='position-absolute bottom-2 start-2'>
                                        @if (item.IsActive)
                                        {
                                            <span class='badge bg-success'>
                                                <span class='position-relative d-inline-block' style='width: 8px; height: 8px; background: white; border-radius: 50%; margin-right: 4px;'></span>
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class='badge bg-secondary'>
                                                <span class='position-relative d-inline-block' style='width: 8px; height: 8px; background: white; border-radius: 50%; margin-right: 4px;'></span>
                                                Nghỉ việc
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class='card-body pb-2'>
                                    <!-- Name & Code -->
                                    <div class='mb-2'>
                                        <h6 class='card-title mb-1 text-truncate'>@item.HoTen</h6>
                                        <small class='text-muted'>Mã: @item.MaNvText</small>
                                    </div>

                                    <!-- Info Grid -->
                                    <div class='small'>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <span class='text-muted'>Vai trò:</span>
                                            <span class='fw-semibold text-end'><span class='badge bg-info'>@item.VaiTro</span></span>
                                        </div>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <span class='text-muted'>Điện thoại:</span>
                                            <span class='text-end text-truncate'>@item.SoDienThoai</span>
                                        </div>
                                        <div class='d-flex justify-content-between mb-2'>
                                            <span class='text-muted'>Ngày sinh:</span>
                                            <span class='text-end'>@item.NgaySinh.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.GioiTinh))
                                        {
                                            <div class='d-flex justify-content-between mb-2'>
                                                <span class='text-muted'>Giới tính:</span>
                                                <span class='text-end'>@item.GioiTinh</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.DiaChi))
                                        {
                                            <div class='d-flex justify-content-between'>
                                                <span class='text-muted'>Địa chỉ:</span>
                                                <span class='text-end text-truncate' title='@item.DiaChi'>@item.DiaChi</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class='card-footer bg-light border-top-0'>
                                    <div class='d-grid gap-2'>
                                        <a asp-action='Edit' asp-route-id='@item.MaNv' class='btn btn-sm btn-primary'>
                                            <i class='bi bi-pencil'></i> Chi tiết
                                        </a>
                                    </div>
                                    <div class='mt-2 d-flex gap-2'>
                                        <a asp-action='Edit' asp-route-id='@item.MaNv' class='btn btn-sm btn-outline-primary flex-grow-1'>
                                            <i class='bi bi-pencil'></i> Sửa
                                        </a>
                                        <a asp-action='Delete' asp-route-id='@item.MaNv' class='btn btn-sm btn-outline-danger'>
                                            <i class='bi bi-trash'></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

    .hover-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
    }

    .bg-gradient {
        background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    }
</style>