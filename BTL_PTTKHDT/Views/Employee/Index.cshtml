@model IEnumerable<BTL_PTTKHDT.Models.NhanVien>
@{ ViewData["Title"] = "Quản lý Nhân sự"; }
<div class='container-fluid'>
    <div class='d-flex justify-content-between align-items-center mb-4'>
        <h2>Quản lý Nhân sự</h2>
        <a asp-action='Create' class='btn btn-primary'>
            <i class='bi bi-plus-lg me-1'></i>+ Thêm nhân viên
        </a>
    </div>
    @if (TempData["EmployeeSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["EmployeeSuccess"]</div>
    }
    @if (TempData["EmployeeWarning"] != null)
    {
        <div class="alert alert-warning">@TempData["EmployeeWarning"]</div>
    }
    @if (TempData["EmployeeError"] != null)
    {
        <div class="alert alert-danger">@TempData["EmployeeError"]</div>
    }
    <div class='card mb-3'>
        <div class='card-body'>
            <form method='get' class='d-flex gap-2' style='max-width:400px'>
                <input type='text' name='q' value='@ViewBag.Query' class='form-control' placeholder='Tìm kiếm theo mã, họ tên, SĐT...' />
                <button class='btn btn-outline-secondary' type='submit'>
                    <i class='bi bi-search'></i> Tìm
                </button>
            </form>
        </div>
    </div>

    <div class='card'>
        <div class='card-body p-0'>
            @if (!Model.Any())
            {
                <div class='text-center text-secondary py-5'>
                    <i class='bi bi-inbox' style='font-size: 3rem; opacity: 0.5;'></i>
                    <p class='mt-3 mb-0'>Không có nhân viên nào.</p>
                </div>
            }
            else
            {
                <div class='row g-3 p-4'>
                    @foreach(var item in Model) {
                        <div class='col-12 col-sm-6 col-lg-4 col-xl-3'>
                            <div class='card h-100 border-0 shadow-sm hover-card'
                                 style='cursor: pointer;'
                                 onclick="window.location='@Url.Action("Edit", new { id = item.MaNv })'">
                                <!-- Avatar Section -->
                                <div class='profile-card-head position-relative'>
                                    <div class='profile-card-cover'></div>
                                    <div class='profile-avatar-wrap'>
                                        @if (!string.IsNullOrWhiteSpace(item.AnhDaiDienUrl))
                                        {
                                            <img src='@item.AnhDaiDienUrl' alt='@item.HoTen' class='profile-avatar-img'>
                                        }
                                        else
                                        {
                                            <div class='profile-avatar-placeholder'>
                                                <i class='bi bi-person'></i>
                                            </div>
                                        }
                                    </div>
                                    <!-- Role Badge -->
                                    <span class='badge nv-role-badge position-absolute' style='top: 12px; right: 12px;'>
                                        <i class='bi bi-briefcase me-1'></i>@item.VaiTro
                                    </span>
                                    <!-- Status Badge -->
                                    <div class='position-absolute' style='bottom: 12px; right: 12px;'>
                                        @if (item.IsActive)
                                        {
                                            <span class='badge status-badge-active'>
                                                <span class='status-dot'></span>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class='badge status-badge-inactive'>
                                                <span class='status-dot'></span>Nghỉ việc
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class='card-body profile-card-body pb-2'>
                                    <div class='mb-2'>
                                        <h6 class='card-title mb-0 text-truncate fw-semibold'>@item.HoTen</h6>
                                        <small class='text-muted'>Mã: @item.MaNvText</small>
                                    </div>
                                    <div class='info-grid small'>
                                        <div class='info-row'>
                                            <span class='info-label'><i class='bi bi-telephone me-1'></i>Điện thoại</span>
                                            <span class='info-value fw-medium'>@item.SoDienThoai</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <div class='info-row'>
                                                <span class='info-label'><i class='bi bi-envelope me-1'></i>Gmail</span>
                                                <span class='info-value text-truncate' title='@item.Email'>@item.Email</span>
                                            </div>
                                        }
                                        <div class='info-row'>
                                            <span class='info-label'><i class='bi bi-calendar3 me-1'></i>Ngày sinh</span>
                                            <span class='info-value'>@item.NgaySinh.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.GioiTinh))
                                        {
                                            <div class='info-row'>
                                                <span class='info-label'><i class='bi bi-gender-ambiguous me-1'></i>Giới tính</span>
                                                <span class='info-value'>@item.GioiTinh</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.DiaChi))
                                        {
                                            <div class='info-row'>
                                                <span class='info-label'><i class='bi bi-geo-alt me-1'></i>Địa chỉ</span>
                                                <span class='info-value text-truncate' title='@item.DiaChi'>@item.DiaChi</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Action Bar -->
                                <div class='card-action-bar' onclick='event.stopPropagation();'>
                                    <a asp-action='Edit' asp-route-id='@item.MaNv'
                                       class='action-btn action-btn-edit'
                                       title='Chỉnh sửa thông tin'>
                                        <i class='bi bi-pencil-square'></i>
                                        <span>Sửa</span>
                                    </a>
                                    <div class='action-divider'></div>
                                    <a asp-action='Delete' asp-route-id='@item.MaNv'
                                       class='action-btn action-btn-delete'
                                       title='Xóa nhân viên'>
                                        <i class='bi bi-trash3'></i>
                                        <span>Xóa</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ── Card hover ── */
    .hover-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border-radius: 12px !important;
        border: 1px solid #e5e7eb !important;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06) !important;
    }
    .hover-card:hover {
        transform: translateY(-4px);
        border-color: #cbd5e1 !important;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.12) !important;
    }

    /* ── Avatar placeholder ── */
    .profile-card-head {
        height: 118px;
        border-radius: 12px 12px 0 0;
        overflow: visible;
        background: #f8fafc;
    }
    .profile-card-cover {
        height: 92px;
        border-radius: 12px 12px 28px 28px;
        background:
            linear-gradient(135deg, rgba(79, 70, 229, 0.14), rgba(14, 165, 233, 0.16)),
            linear-gradient(90deg, #f8fafc, #eef2f7);
        box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.72);
    }
    .profile-avatar-wrap {
        position: absolute;
        left: 18px;
        bottom: -28px;
        width: 84px;
        height: 84px;
        border-radius: 999px;
        padding: 4px;
        background: #fff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    }
    .profile-avatar-img,
    .profile-avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        object-fit: cover;
    }
    .profile-avatar-placeholder {
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 52%, #e0f2fe 100%);
        color: #4f46e5;
        font-size: 2.25rem;
    }
    .profile-card-body {
        padding-top: 2.25rem;
    }

    .avatar-placeholder {
        background: linear-gradient(135deg, #eef2ff 0%, #dde4f5 100%);
    }
    .avatar-icon {
        font-size: 4rem;
        color: #a0b2cc;
    }

    /* ── Badges ── */
    .nv-role-badge {
        background: rgba(15,23,42,0.65);
        backdrop-filter: blur(4px);
        font-size: 0.70rem;
        padding: 4px 8px;
        border-radius: 20px;
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .status-badge-active {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        font-size: 0.72rem;
        padding: 4px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .status-badge-inactive {
        background: rgba(100,116,139,0.75);
        backdrop-filter: blur(4px);
        font-size: 0.72rem;
        padding: 4px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .status-dot {
        width: 7px; height: 7px;
        background: #fff;
        border-radius: 50%;
        display: inline-block;
    }

    /* ── Info rows ── */
    .info-grid { display: flex; flex-direction: column; gap: 6px; }
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }
    .info-label { color: #6b7280; white-space: nowrap; }
    .info-value { color: #1e293b; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 55%; }

    /* ── Action Bar ── */
    .card-action-bar {
        display: flex;
        align-items: stretch;
        border-top: 1px solid #e5e7eb;
        background: #f8fafc;
    }
    .action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 0;
        font-size: 0.82rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .action-btn-edit { color: #3b82f6; }
    .action-btn-edit:hover { background: #eff6ff; color: #1d4ed8; }
    .action-btn-delete { color: #ef4444; }
    .action-btn-delete:hover { background: #fef2f2; color: #b91c1c; }
    .action-divider {
        width: 1px;
        background: #e2e8f0;
        margin: 8px 0;
    }
</style>
