@model BTL_PTTKHDT.Models.NhanVien
@{ ViewData["Title"] = "Sửa nhân viên"; }
<div class='container-fluid'>
  <h2>Sửa nhân viên: @Model.HoTen</h2>
  <div class="card p-3">
            <form asp-action='Edit' method='post' enctype='multipart/form-data'>
          <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>
          <input type="hidden" asp-for="MaNv" />
                  <div class='mb-3'>
                      <label>Mã nhân viên</label>
                      <input class='form-control' value='@Model.MaNv' readonly />
                  </div>
          <div class='mb-3'><label>Họ tên</label><input asp-for='HoTen' class='form-control' /><span asp-validation-for='HoTen' class='text-danger'></span></div>
          <div class='mb-3'><label>SĐT</label><input asp-for='SoDienThoai' class='form-control' maxlength="10" inputmode="numeric" /><span asp-validation-for='SoDienThoai' class='text-danger'></span></div>
          <div class='mb-3'><label>Gmail nhận mã quên mật khẩu</label><input asp-for='Email' type='email' class='form-control' autocomplete='email' placeholder='ten@gmail.com' /><span asp-validation-for='Email' class='text-danger'></span></div>
          <div class='mb-3'><label>Ngày sinh</label><input asp-for='NgaySinh' type='date' class='form-control' /><span asp-validation-for='NgaySinh' class='text-danger'></span></div>
          <div class='mb-3'><label>Giới tính</label><select asp-for='GioiTinh' class='form-select'><option value=''>-- Chọn giới tính --</option><option value='Nam'>Nam</option><option value='Nữ'>Nữ</option></select><span asp-validation-for='GioiTinh' class='text-danger'></span></div>
          <div class='mb-3'><label>Địa chỉ</label><input asp-for='DiaChi' class='form-control' /><span asp-validation-for='DiaChi' class='text-danger'></span></div>
          <div class='mb-3'>
              <label>Vai trò</label>
              <select asp-for='VaiTro' class='form-select'>
                  <option value=''>-- Chọn vai trò --</option>
                  <option value='Giao dịch viên'>Giao dịch viên</option>
                  <option value='Nhân viên tin dung'>Nhân viên tín dụng</option>
                  <option value='Nhân viên thu no'>Nhân viên thu nợ</option>
                  <option value='Kiểm soát viên'>Kiểm soát viên</option>
                  <option value='Trưởng phòng'>Trưởng phòng</option>
                  <option value='Quản trị hệ thống'>Quản trị hệ thống</option>
              </select>
              <span asp-validation-for='VaiTro' class='text-danger'></span>
          </div>
          <div class='mb-3'>
              <label>Ảnh đại diện (chọn file mới nếu muốn đổi)</label>
              <input type='file' name='AnhDaiDienFile' class='form-control' accept='image/*' />
              @Html.ValidationMessage("AnhDaiDienFile", "", new { @class = "text-danger" })
          </div>
          <div class='mb-3'>
              <div class="form-check">
                  <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                  <label class="form-check-label" asp-for="IsActive">Hoạt động</label>
              </div>
          </div>
          <button type='submit' class='btn btn-primary'>Lưu</button>
          <a asp-action='Index' class='btn btn-secondary'>Hủy</a>
      </form>
  </div>
</div>
