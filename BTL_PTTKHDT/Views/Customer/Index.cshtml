@model BTL_PTTKHDT.Models.CustomerListViewModel

@{
    ViewData["Title"] = "Quản lý Khách hàng";

    string typeValue = (Model.Type ?? string.Empty).Trim().ToLowerInvariant();
    bool isPersonal = typeValue is "canhan" or "ca-nhan" or "personal";
    bool isBusiness = typeValue is "doanhnghiep" or "doanh-nghiep" or "business";

    int totalPages = Model.TotalPages;
    if (totalPages < 1) totalPages = 1;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="h4 mb-0">Quản lý Khách hàng</div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>
            Thêm khách hàng mới
        </a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Query" class="form-control" placeholder="Tìm kiếm theo mã, họ tên, SDT..." />
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-funnel"></i></span>
                    <select name="type" class="form-select">
                        <option value="" selected="@(!isPersonal && !isBusiness)">Tất cả loại khách hàng</option>
                        <option value="canhan" selected="@isPersonal">Cá nhân</option>
                        <option value="doanhnghiep" selected="@isBusiness">Doanh nghiệp</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-lg-2">
                <button class="btn btn-outline-secondary w-100" type="submit">Lọc</button>
            </div>

            <div class="col-12 col-lg-2">
                <a class="btn btn-light w-100" href="@Url.Action("Index")">Xóa lọc</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.5;"></i>
                <p class="mt-3 mb-0">Không có khách hàng phù hợp.</p>
            </div>
        }
        else
        {
            <div class="row g-3 p-4">
                @foreach (var row in Model.Items)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm hover-card" style="cursor: pointer;" data-customer-id="@row.MaKh">
                            <!-- Avatar Section -->
                            <div class="position-relative bg-light" style="height: 180px; border-radius: 8px 8px 0 0; overflow: hidden;">
                                @if (!string.IsNullOrWhiteSpace(row.AnhDaiDienUrl))
                                {
                                    <img src="@row.AnhDaiDienUrl" alt="@row.HoTen" class="w-100 h-100" style="object-fit: cover;">
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-gradient">
                                        @if (row.LoaiKhachHangKind == "business")
                                        {
                                            <i class="bi bi-buildings" style="font-size: 4rem; color: #d9d9d9;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle" style="font-size: 4rem; color: #d9d9d9;"></i>
                                        }
                                    </div>
                                }
                                <!-- Badge loại KH -->
                                <span class="badge position-absolute top-2 end-2" style="background-color: rgba(0,0,0,0.6);">
                                    @if (row.LoaiKhachHangKind == "business")
                                    {
                                        <i class="bi bi-buildings me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-person me-1"></i>
                                    }
                                    @row.LoaiKhachHangText
                                </span>
                                <!-- Status Badge -->
                                <div class="position-absolute bottom-2 start-2">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <span class="position-relative d-inline-block" style="width: 8px; height: 8px; background: white; border-radius: 50%; margin-right: 4px;"></span>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <span class="position-relative d-inline-block" style="width: 8px; height: 8px; background: white; border-radius: 50%; margin-right: 4px;"></span>
                                            Tạm ngưng
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body pb-2">
                                <!-- Name & Code -->
                                <div class="mb-2">
                                    <h6 class="card-title mb-1 text-truncate">@row.HoTen</h6>
                                    <small class="text-muted">Mã: @row.MaKhText</small>
                                </div>

                                <!-- Info Grid -->
                                <div class="small">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Điện thoại:</span>
                                        <span class="fw-semibold text-end text-truncate">@row.SoDienThoai</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Ngày sinh:</span>
                                        <span class="text-end">@row.NgaySinh.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(row.CmndCccd))
                                    {
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">CMND/CCCD:</span>
                                            <span class="text-end text-truncate">@row.CmndCccd</span>
                                        </div>
                                    }
                                    @if (row.DiemTinDung.HasValue)
                                    {
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Điểm tín dụng:</span>
                                            <span class="fw-semibold @(row.DiemTinDung >= 700 ? "text-success" : row.DiemTinDung >= 500 ? "text-warning" : "text-danger")">
                                                @row.DiemTinDung
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="card-footer bg-light border-top-0">
                                <div class="d-grid gap-2">
                                    <a asp-action="Edit" asp-route-id="@row.MaKh" class="btn btn-sm btn-primary" onclick="event.stopPropagation();">
                                        <i class="bi bi-pencil"></i> Chi tiết
                                    </a>
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@row.MaKh" class="btn btn-sm btn-outline-primary flex-grow-1" onclick="event.stopPropagation();">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@row.MaKh" class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation();">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Pagination Footer -->
    <div class="card-footer bg-white d-flex align-items-center justify-content-between">
        <div class="text-secondary small">
            Hiển thị @Model.From-@Model.To trong số @Model.TotalCount khách hàng
        </div>

        <nav aria-label="Customer pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = Model.Page - 1, pageSize = Model.PageSize })" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int p = 1; p <= Math.Min(totalPages, 5); p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = p, pageSize = Model.PageSize })">@p</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = Model.Page + 1, pageSize = Model.PageSize })" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

    .hover-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
    }

    .bg-gradient {
        background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    }
</style>
