@model BTL_PTTKHDT.Models.CustomerListViewModel

@{
    ViewData["Title"] = "Quản lý Khách hàng";

    string typeValue = (Model.Type ?? string.Empty).Trim().ToLowerInvariant();
    bool isPersonal = typeValue is "canhan" or "ca-nhan" or "personal";
    bool isBusiness = typeValue is "doanhnghiep" or "doanh-nghiep" or "business";

    int totalPages = Model.TotalPages;
    if (totalPages < 1) totalPages = 1;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="h4 mb-0">Quản lý Khách hàng</div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>
            Thêm khách hàng mới
        </a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Query" class="form-control" placeholder="Tìm kiếm theo mã, họ tên, SDT..." />
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-funnel"></i></span>
                    <select name="type" class="form-select">
                        <option value="" selected="@(!isPersonal && !isBusiness)">Tất cả loại khách hàng</option>
                        <option value="canhan" selected="@isPersonal">Cá nhân</option>
                        <option value="doanhnghiep" selected="@isBusiness">Doanh nghiệp</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-lg-2">
                <button class="btn btn-outline-secondary w-100" type="submit">Lọc</button>
            </div>

            <div class="col-12 col-lg-2">
                <a class="btn btn-light w-100" href="@Url.Action("Index")">Xóa lọc</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.5;"></i>
                <p class="mt-3 mb-0">Không có khách hàng phù hợp.</p>
            </div>
        }
        else
        {
            <div class="row g-3 p-4">
                @foreach (var row in Model.Items)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm hover-card"
                             style="cursor: pointer;"
                             onclick="window.location='@Url.Action("Edit", new { id = row.MaKh })'">
                            <!-- Avatar Section -->
                            <div class="position-relative" style="height: 180px; border-radius: 8px 8px 0 0; overflow: hidden;">
                                @if (!string.IsNullOrWhiteSpace(row.AnhDaiDienUrl))
                                {
                                    <img src="@row.AnhDaiDienUrl" alt="@row.HoTen" class="w-100 h-100" style="object-fit: cover;">
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center avatar-placeholder">
                                        @if (row.LoaiKhachHangKind == "business")
                                        {
                                            <i class="bi bi-buildings avatar-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle avatar-icon"></i>
                                        }
                                    </div>
                                }
                                <!-- Badge loại KH -->
                                <span class="badge kh-type-badge position-absolute" style="top: 10px; right: 10px;">
                                    @if (row.LoaiKhachHangKind == "business")
                                    {
                                        <i class="bi bi-buildings me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-person me-1"></i>
                                    }
                                    @row.LoaiKhachHangText
                                </span>
                                <!-- Status Badge -->
                                <div class="position-absolute" style="bottom: 10px; left: 10px;">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge status-badge-active">
                                            <span class="status-dot"></span>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-badge-inactive">
                                            <span class="status-dot"></span>Tạm ngưng
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body pb-2">
                                <div class="mb-2">
                                    <h6 class="card-title mb-0 text-truncate fw-semibold">@row.HoTen</h6>
                                    <small class="text-muted">Mã: @row.MaKhText</small>
                                </div>
                                <div class="info-grid small">
                                    <div class="info-row">
                                        <span class="info-label"><i class="bi bi-telephone me-1"></i>Điện thoại</span>
                                        <span class="info-value fw-medium">@row.SoDienThoai</span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label"><i class="bi bi-calendar3 me-1"></i>Ngày sinh</span>
                                        <span class="info-value">@row.NgaySinh.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(row.CmndCccd))
                                    {
                                        <div class="info-row">
                                            <span class="info-label"><i class="bi bi-card-text me-1"></i>CMND/CCCD</span>
                                            <span class="info-value text-truncate">@row.CmndCccd</span>
                                        </div>
                                    }
                                    @if (row.DiemTinDung.HasValue)
                                    {
                                        <div class="info-row">
                                            <span class="info-label"><i class="bi bi-star me-1"></i>Điểm tín dụng</span>
                                            <span class="info-value fw-semibold @(row.DiemTinDung >= 700 ? "credit-good" : row.DiemTinDung >= 500 ? "credit-medium" : "credit-bad")">
                                                @row.DiemTinDung
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Bar -->
                            <div class="card-action-bar" onclick="event.stopPropagation();">
                                <a asp-action="Edit" asp-route-id="@row.MaKh"
                                   class="action-btn action-btn-edit"
                                   title="Chỉnh sửa thông tin">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Sửa</span>
                                </a>
                                <div class="action-divider"></div>
                                <a asp-action="Delete" asp-route-id="@row.MaKh"
                                   class="action-btn action-btn-delete"
                                   title="Xóa khách hàng">
                                    <i class="bi bi-trash3"></i>
                                    <span>Xóa</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Pagination Footer -->
    <div class="card-footer bg-white d-flex align-items-center justify-content-between">
        <div class="text-secondary small">
            Hiển thị @Model.From-@Model.To trong số @Model.TotalCount khách hàng
        </div>

        <nav aria-label="Customer pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = Model.Page - 1, pageSize = Model.PageSize })" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int p = 1; p <= Math.Min(totalPages, 5); p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = p, pageSize = Model.PageSize })">@p</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = Model.Query, type = Model.Type, page = Model.Page + 1, pageSize = Model.PageSize })" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    /* ── Card hover ── */
    .hover-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border-radius: 12px !important;
        overflow: hidden;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.12) !important;
    }

    /* ── Avatar placeholder ── */
    .avatar-placeholder {
        background: linear-gradient(135deg, #e8eef7 0%, #d0daea 100%);
    }
    .avatar-icon {
        font-size: 4rem;
        color: #a0b2cc;
    }

    /* ── Badges ── */
    .kh-type-badge {
        background: rgba(15,23,42,0.65);
        backdrop-filter: blur(4px);
        font-size: 0.72rem;
        padding: 4px 8px;
        border-radius: 20px;
    }
    .status-badge-active {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        font-size: 0.72rem;
        padding: 4px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .status-badge-inactive {
        background: rgba(100,116,139,0.75);
        backdrop-filter: blur(4px);
        font-size: 0.72rem;
        padding: 4px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .status-dot {
        width: 7px; height: 7px;
        background: #fff;
        border-radius: 50%;
        display: inline-block;
    }

    /* ── Info rows ── */
    .info-grid { display: flex; flex-direction: column; gap: 6px; }
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }
    .info-label { color: #6b7280; white-space: nowrap; }
    .info-value { color: #1e293b; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 55%; }
    .credit-good   { color: #16a34a; }
    .credit-medium { color: #d97706; }
    .credit-bad    { color: #dc2626; }

    /* ── Action Bar ── */
    .card-action-bar {
        display: flex;
        align-items: stretch;
        border-top: 1px solid #f1f5f9;
        background: #fafbfc;
    }
    .action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 0;
        font-size: 0.82rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
    }
    .action-btn-edit {
        color: #3b82f6;
    }
    .action-btn-edit:hover {
        background: #eff6ff;
        color: #1d4ed8;
    }
    .action-btn-delete {
        color: #ef4444;
    }
    .action-btn-delete:hover {
        background: #fef2f2;
        color: #b91c1c;
    }
    .action-divider {
        width: 1px;
        background: #e2e8f0;
        margin: 8px 0;
    }
</style>
