@model BTL_PTTKHDT.Models.KhachHang
@{
    ViewData["Title"] = "Thêm khách hàng mới";
    var maxBirthDate = DateOnly.FromDateTime(DateTime.Today).AddYears(-18).ToString("yyyy-MM-dd");
    var birthDateValue = Model.NgaySinh.Year < 1900 ? maxBirthDate : Model.NgaySinh.ToString("yyyy-MM-dd");
    var pendingPasswordToken = ViewData["PendingPasswordToken"] as string;
}

<div class="container-fluid">
    <h2>@ViewData["Title"]</h2>
    <div class="card p-3">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="AnhDaiDienUrl" />
            <input type="hidden" name="matKhauToken" value="@pendingPasswordToken" />
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Mã khách hàng</label>
                    <input type="hidden" asp-for="MaKh" />
                    <input class="form-control" value="@Model.MaKh" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="LoaiKhachHang" class="form-label">Loại khách hàng</label>
                    <select asp-for="LoaiKhachHang" class="form-select js-customer-type">
                        <option value="Cá nhân">Cá nhân</option>
                        <option value="Doanh nghiệp">Doanh nghiệp</option>
                    </select>
                    <span asp-validation-for="LoaiKhachHang" class="text-danger"></span>
                </div>
            </div>

            <div class="personal-fields">
                <div class="border rounded-3 p-3">
                    <div class="fw-semibold mb-2">Thông tin cá nhân</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="HoTen" class="form-label">Họ tên</label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CmndCccd" class="form-label">CMND/CCCD</label>
                            <input asp-for="CmndCccd" class="form-control" maxlength="20" inputmode="numeric" />
                            <span asp-validation-for="CmndCccd" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                            <input id="NgaySinh" name="NgaySinh" type="date" class="form-control" max="@maxBirthDate" value="@birthDateValue" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" maxlength="15" inputmode="numeric" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NgheNghiep" class="form-label">Nghề nghiệp</label>
                            <input asp-for="NgheNghiep" class="form-control" />
                            <span asp-validation-for="NgheNghiep" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NoiLamViec" class="form-label">Nơi làm việc</label>
                            <input asp-for="NoiLamViec" class="form-control" />
                            <span asp-validation-for="NoiLamViec" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ChucVu" class="form-label">Chức vụ</label>
                            <input asp-for="ChucVu" class="form-control" />
                            <span asp-validation-for="ChucVu" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ThuNhapHangThang" class="form-label">Thu nhập hàng tháng</label>
                            <input asp-for="ThuNhapHangThang" class="form-control" inputmode="numeric" />
                            <span asp-validation-for="ThuNhapHangThang" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="business-fields">
                <div class="border rounded-3 p-3 mb-3">
                    <div class="fw-semibold mb-2">Thông tin pháp lý doanh nghiệp</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="HoTen" class="form-label">Tên doanh nghiệp</label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MaSoThue" class="form-label">Mã số thuế</label>
                            <input asp-for="MaSoThue" class="form-control" maxlength="20" />
                            <span asp-validation-for="MaSoThue" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NgayThanhLap" class="form-label">Ngày thành lập</label>
                            <input asp-for="NgayThanhLap" type="date" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="LinhVucKinhDoanh" class="form-label">Lĩnh vực kinh doanh</label>
                            <input asp-for="LinhVucKinhDoanh" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SoLaoDong" class="form-label">Số lao động</label>
                            <input asp-for="SoLaoDong" class="form-control" inputmode="numeric" />
                        </div>
                    </div>
                </div>

                <div class="border rounded-3 p-3 mb-3">
                    <div class="fw-semibold mb-2">Người đại diện</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="TenNguoiDaiDien" class="form-label">Họ tên nguoi dai dien</label>
                            <input asp-for="TenNguoiDaiDien" class="form-control" />
                            <span asp-validation-for="TenNguoiDaiDien" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ChucVuNguoiDaiDien" class="form-label">Chức vụ</label>
                            <input asp-for="ChucVuNguoiDaiDien" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CmndCccd" class="form-label">CCCD người đại diện</label>
                            <input asp-for="CmndCccd" class="form-control" maxlength="20" inputmode="numeric" />
                            <span asp-validation-for="CmndCccd" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NgaySinh" class="form-label">Ngày sinh người đại diện</label>
                            <input id="NgaySinhBusiness" name="NgaySinh" type="date" class="form-control" max="@maxBirthDate" value="@birthDateValue" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SoDienThoai" class="form-label">Số điện thoại lien he</label>
                            <input asp-for="SoDienThoai" class="form-control" maxlength="15" inputmode="numeric" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label">Email liên hệ</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="border rounded-3 p-3">
                    <div class="fw-semibold mb-2">Địa chỉ va tai chinh</div>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="DiaChi" class="form-label">Địa chỉ tru so</label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DoanhThuBinhQuanThang" class="form-label">Doanh thu bình quân tháng</label>
                            <input asp-for="DoanhThuBinhQuanThang" class="form-control" inputmode="numeric" />
                            <span asp-validation-for="DoanhThuBinhQuanThang" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LoiNhuanBinhQuanThang" class="form-label">Lợi nhuận bình quân tháng</label>
                            <input asp-for="LoiNhuanBinhQuanThang" class="form-control" inputmode="numeric" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <label class="form-label">Ảnh đại diện</label>
                <input type="file" name="AnhDaiDienFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrWhiteSpace(Model.AnhDaiDienUrl))
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <img src="@Model.AnhDaiDienUrl" alt="Ảnh đại diện đã chọn" class="rounded-circle" style="width:48px;height:48px;object-fit:cover;object-position:center 25%;" />
                        <span class="form-text text-success">Ảnh đã chọn được giữ tạm. Chọn file mới nếu muốn đổi.</span>
                    </div>
                }
                <div class="form-text">Khách hàng doanh nghiệp có thể không cần ảnh đại diện.</div>
                @Html.ValidationMessage("AnhDaiDienFile", "", new { @class = "text-danger" })
            </div>

            <div class="mt-3">
                <label class="form-label" for="matKhau">Mật khẩu cổng khách hàng</label>
                <input id="matKhau" name="matKhau" type="password" class="form-control" minlength="6" autocomplete="new-password" />
                @if (!string.IsNullOrWhiteSpace(pendingPasswordToken))
                {
                    <div class="form-text text-success">Mật khẩu đã nhập hợp lệ và được giữ tạm. Có thể để trống ô này khi bấm Lưu lại.</div>
                }
                <div class="form-text">Khách hàng sẽ đăng nhập bằng số điện thoại vừa nhập.</div>
                @Html.ValidationMessage("matKhau", "", new { @class = "text-danger" })
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const type = document.querySelector('.js-customer-type');
            const personal = document.querySelector('.personal-fields');
            const business = document.querySelector('.business-fields');

            function setDisabled(container, disabled) {
                container.querySelectorAll('input, select, textarea').forEach(el => {
                    if (!el.classList.contains('js-customer-type')) el.disabled = disabled;
                });
            }

            function sync() {
                const isBusiness = (type.value || '').toLowerCase().includes('doanh');
                personal.style.display = isBusiness ? 'none' : '';
                business.style.display = isBusiness ? '' : 'none';
                setDisabled(personal, isBusiness);
                setDisabled(business, !isBusiness);
            }

            type.addEventListener('change', sync);
            sync();
        })();
    </script>
}
