@model BTL_PTTKHDT.Models.KhachHang
@{ ViewData["Title"] = "Sửa khách hàng"; }
<div class='container-fluid'>
  <h2>Sửa khách hàng: @Model.HoTen</h2>
  <div class="card p-3">
      <form asp-action='Edit' method='post' enctype='multipart/form-data'>
          <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>
          <input type="hidden" asp-for="MaKh" />
          <div class='mb-3'>
              <label>Mã khách hàng</label>
              <input class='form-control' value='@Model.MaKh' readonly />
          </div>
          <div class='mb-3'><label>Họ tên</label><input asp-for='HoTen' class='form-control' /><span asp-validation-for='HoTen' class='text-danger'></span></div>
          <div class='mb-3'><label>CMND/CCCD</label><input asp-for='CmndCccd' class='form-control' maxlength="12" inputmode="numeric" /><span asp-validation-for='CmndCccd' class='text-danger'></span></div>
          <div class='mb-3'><label>SĐT</label><input asp-for='SoDienThoai' class='form-control' maxlength="10" inputmode="numeric" /><span asp-validation-for='SoDienThoai' class='text-danger'></span></div>
          <div class='mb-3'><label>Ngày sinh</label><input asp-for='NgaySinh' type='date' class='form-control' /><span asp-validation-for='NgaySinh' class='text-danger'></span></div>
          <div class='mb-3'><label>Email</label><input asp-for='Email' type='email' class='form-control' /><span asp-validation-for='Email' class='text-danger'></span></div>
          <div class='mb-3'><label>Địa chỉ</label><input asp-for='DiaChi' class='form-control' /><span asp-validation-for='DiaChi' class='text-danger'></span></div>
          <div class='mb-3'><label>Loại khách hàng</label><input asp-for='LoaiKhachHang' class='form-control' /><span asp-validation-for='LoaiKhachHang' class='text-danger'></span></div>
          <div class='mb-3'>
              <label>Ảnh đại diện (chọn file mới nếu muốn đổi)</label>
              <input type='file' name='AnhDaiDienFile' class='form-control' accept='image/*' />
              <div class='form-text'>Khách hàng doanh nghiệp có thể không cần ảnh đại diện.</div>
              @Html.ValidationMessage("AnhDaiDienFile", "", new { @class = "text-danger" })
          </div>
          <div class='mb-3'>
              <div class="form-check">
                  <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                  <label class="form-check-label" asp-for="IsActive">Hoạt động</label>
              </div>
          </div>
          <button type='submit' class='btn btn-primary'>Lưu</button>
          <a asp-action='Index' class='btn btn-secondary'>Hủy</a>
      </form>
  </div>

  <div class="card p-3 mt-3">
      <div class="d-flex align-items-center justify-content-between">
          <h5 class="mb-0">Tài sản khách hàng</h5>
          <span class="text-secondary small">@Model.MaKh</span>
      </div>

      @if (TempData["AssetError"] != null)
      {
          <div class="alert alert-danger mt-3 mb-0">@TempData["AssetError"]</div>
      }

      <form asp-action="AddAsset" asp-route-id="@Model.MaKh" method="post" class="border rounded-3 p-3 mt-3">
          @Html.AntiForgeryToken()
          <div class="row g-2">
              <div class="col-md-4">
                  <label class="form-label small text-secondary mb-1">Loại tài sản</label>
                  <input name="LoaiTaiSan" class="form-control form-control-sm" />
              </div>
              <div class="col-md-3">
                  <label class="form-label small text-secondary mb-1">Giá trị khai báo</label>
                  <input name="GiaTriKhaiBao" class="form-control form-control-sm" inputmode="numeric" />
              </div>
              <div class="col-md-2">
                  <label class="form-label small text-secondary mb-1">Tỷ lệ LTV</label>
                  <input name="TyLeLtv" class="form-control form-control-sm" value="0.7" inputmode="decimal" />
              </div>
              <div class="col-md-3 d-flex align-items-end">
                  <button class="btn btn-sm btn-primary w-100" type="submit">Thêm tài sản</button>
              </div>
              <div class="col-md-6">
                  <label class="form-label small text-secondary mb-1">Giấy tờ pháp lý</label>
                  <input name="GiayToPhapLy" class="form-control form-control-sm" />
              </div>
              <div class="col-md-6">
                  <label class="form-label small text-secondary mb-1">Mô tả</label>
                  <input name="MoTa" class="form-control form-control-sm" />
              </div>
          </div>
      </form>

      @{
          var assets = ViewData["CustomerAssets"] as IEnumerable<BTL_PTTKHDT.Models.TaiSanKhachHang>;
          var list = assets?.ToList() ?? new List<BTL_PTTKHDT.Models.TaiSanKhachHang>();
      }

      @if (list.Count == 0)
      {
          <div class="text-secondary mt-3">Chưa có tài sản.</div>
      }
      else
      {
          <div class="table-responsive mt-3">
              <table class="table table-sm align-middle mb-0">
                  <thead>
                      <tr class="text-secondary small">
                          <th>Mã</th>
                          <th>Loại</th>
                          <th class="text-end">Khai báo</th>
                          <th class="text-end">Định giá</th>
                          <th class="text-center">LTV</th>
                          <th class="text-center">Trạng thái</th>
                      </tr>
                  </thead>
                  <tbody>
                      @foreach (var ts in list)
                      {
                          <tr>
                              <td class="fw-semibold">@ts.MaTaiSanKh</td>
                              <td>
                                  <div class="fw-semibold">@ts.LoaiTaiSan</div>
                                  @if (!string.IsNullOrWhiteSpace(ts.MoTa))
                                  {
                                      <div class="text-secondary small">@ts.MoTa</div>
                                  }
                              </td>
                              <td class="text-end">@ts.GiaTriKhaiBao.ToString("N0")</td>
                              <td class="text-end">@(ts.GiaTriDinhGia.HasValue ? ts.GiaTriDinhGia.Value.ToString("N0") : "-")</td>
                              <td class="text-center">@($"{ts.TyLeLtv * 100:0.#}%")</td>
                              <td class="text-center"><span class="badge text-bg-light">@ts.TrangThai</span></td>
                          </tr>
                      }
                  </tbody>
              </table>
          </div>
      }
  </div>
</div>