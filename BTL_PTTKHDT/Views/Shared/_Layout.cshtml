<!DOCTYPE html>
@inject IPermissionService PermissionService
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BTL_PTTKHDT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.lordicon.com/lordicon.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BTL_PTTKHDT.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty);
        var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty);
        bool IsActive(string controller, string? action = null)
        {
            if (!currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)) return false;
            if (action is null) return true;
            return currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        }
        var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
        var isCustomer = User.IsInRole(AppRoles.KhachHang);
        var canDashboard = await PermissionService.HasPermissionAsync(User, AppPermissions.ViewDashboard);
        var canCustomers = await PermissionService.HasPermissionAsync(User, AppPermissions.ViewCustomers);
        var canEmployees = await PermissionService.HasPermissionAsync(User, AppPermissions.ManageEmployees);
        var canLoans = await PermissionService.HasPermissionAsync(User, AppPermissions.ViewLoans);
        var canDisbursement = await PermissionService.HasPermissionAsync(User, AppPermissions.DisburseLoans);
        var canDebt = await PermissionService.HasPermissionAsync(User, AppPermissions.ViewDebts);
        var appToastMessages = new List<Dictionary<string, string>>();
        foreach (var key in TempData.Keys.ToList())
        {
            if (TempData[key] is not string message || string.IsNullOrWhiteSpace(message))
            {
                continue;
            }

            var normalizedKey = key.ToLowerInvariant();
            var tone = normalizedKey.Contains("error") ? "danger"
                : normalizedKey.Contains("warning") ? "warning"
                : "success";
            var title = tone == "danger" ? "Không thể thực hiện"
                : tone == "warning" ? "Cần chú ý"
                : "Thành công";
            var icon = tone == "danger" ? "bi-exclamation-triangle"
                : tone == "warning" ? "bi-info-circle"
                : "bi-check2-circle";

            appToastMessages.Add(new Dictionary<string, string>
            {
                ["tone"] = tone,
                ["title"] = title,
                ["icon"] = icon,
                ["message"] = message
            });
        }
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-brand px-3 py-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="app-brand-mark rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-bank2" aria-hidden="true"></i>
                    </div>
                    <div class="app-brand-copy">
                        <div class="fw-semibold">Hệ thống Tín dụng</div>
                        <div class="text-secondary">Phân tích &amp; Phê duyệt</div>
                    </div>
                </div>
            </div>

            <nav class="px-2 py-2">
                @if (isCustomer)
                {
                    <a class="app-nav-link @(IsActive("CustomerPortal") ? "active" : "")" asp-controller="CustomerPortal" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-person-lines-fill"></i></span>
                        Tổng quan
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-profile">
                        <span class="app-nav-icon"><i class="bi bi-person-vcard-fill"></i></span>
                        Thông tin cá nhân
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-applications">
                        <span class="app-nav-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                        Hồ sơ vay
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-limit">
                        <span class="app-nav-icon"><i class="bi bi-speedometer2"></i></span>
                        Hạn mức vay
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-loans">
                        <span class="app-nav-icon"><i class="bi bi-wallet-fill"></i></span>
                        Khoản vay
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-schedule">
                        <span class="app-nav-icon"><i class="bi bi-calendar2-check-fill"></i></span>
                        Lịch trả nợ
                    </a>
                    <a class="app-nav-link customer-tab-link" asp-controller="CustomerPortal" asp-action="Index" asp-fragment="tab-payments">
                        <span class="app-nav-icon"><i class="bi bi-receipt-cutoff"></i></span>
                        Thanh toán
                    </a>
                }
                @if (canDashboard)
                {
                    <a class="app-nav-link @(IsActive("Home","Index") ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-speedometer2"></i></span>
                        Bảng điều khiển
                    </a>
                }
                @if (canCustomers)
                {
                    <a class="app-nav-link @(IsActive("Customer") ? "active" : "")" asp-controller="Customer" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-people-fill"></i></span>
                        Quản lý khách hàng
                    </a>
                }
                @if (canEmployees)
                {
                    <a class="app-nav-link @(IsActive("Employee") ? "active" : "")" asp-controller="Employee" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-person-badge-fill"></i></span>
                        Quản lý nhân sự
                    </a>
                }
                @if (canLoans)
                {
                    <a class="app-nav-link @(IsActive("Loan") ? "active" : "")" asp-controller="Loan" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-file-earmark-richtext-fill"></i></span>
                        Hồ sơ vay vốn
                    </a>
                }
                @if (canDisbursement)
                {
                    <a class="app-nav-link @(IsActive("Disbursement") ? "active" : "")" asp-controller="Disbursement" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-cash-stack"></i></span>
                        Giải ngân
                    </a>
                }
                @if (canDebt)
                {
                    <a class="app-nav-link @(IsActive("Debt") ? "active" : "")" asp-controller="Debt" asp-action="Index">
                        <span class="app-nav-icon"><i class="bi bi-receipt"></i></span>
                        Quản lý nợ
                    </a>
                }

                <div class="app-nav-divider"></div>

                <a class="app-nav-link" asp-controller="Home" asp-action="Privacy">
                    <span class="app-nav-icon"><i class="bi bi-sliders2"></i></span>
                    Cài đặt
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="app-nav-link app-nav-button text-danger w-100 border-0">
                        <span class="app-nav-icon"><i class="bi bi-box-arrow-right"></i></span>
                        Đăng xuất
                    </button>
                </form>
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar border-bottom">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div class="fw-semibold">@(ViewData["Title"] ?? "Quản lý Tín dụng")</div>

                    <form class="app-search" role="search">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>
                            <input class="form-control" type="search" placeholder="@(IsActive("Loan") ? "Tìm kiếm đơn vay..." : "Tìm kiếm hồ sơ...")" aria-label="Tìm kiếm" />
                        </div>
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-light" aria-label="Thông báo">
                            <i class="bi bi-bell"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-light" aria-label="Trợ giúp">
                            <i class="bi bi-question-circle"></i>
                        </button>
                        <div class="d-flex align-items-center gap-2">
                            <div class="text-end d-none d-md-block">
                                <div class="small fw-semibold">@(User.Identity?.Name ?? "Admin")</div>
                                <div class="text-secondary small">@roleName</div>
                            </div>
                            <div class="app-user rounded-circle d-flex align-items-center justify-content-center" aria-label="Người dùng">
                                <i class="bi bi-person"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (appToastMessages.Count > 0)
    {
        <div class="app-toast-stack toast-container position-fixed top-0 end-0 p-3">
            @for (var i = 0; i < appToastMessages.Count; i++)
            {
                var toast = appToastMessages[i];
                <div class="toast app-toast app-toast-@toast["tone"]" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="4200">
                    <div class="toast-header">
                        <span class="app-toast-icon">
                            <i class="bi @toast["icon"]"></i>
                        </span>
                        <strong class="me-auto">@toast["title"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Đóng"></button>
                    </div>
                    <div class="toast-body">@toast["message"]</div>
                </div>
            }
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
