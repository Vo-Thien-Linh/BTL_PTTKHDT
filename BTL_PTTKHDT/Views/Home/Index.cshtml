@model BTL_PTTKHDT.Models.DashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
}

<section class="dashboard-spotlight mb-3">
    <div class="dashboard-spotlight-icon" aria-hidden="true">
        <lord-icon
            src="https://cdn.lordicon.com/lewtedlh.json"
            trigger="loop"
            delay="1800"
            stroke="light"
            colors="primary:#0f766e,secondary:#ca8a04">
        </lord-icon>
    </div>
    <div class="dashboard-spotlight-copy">
        <div class="dashboard-spotlight-kicker">Tổng quan tín dụng</div>
        <h1 class="dashboard-spotlight-title">Theo dõi giải ngân, thu nợ và rủi ro trong một nhịp nhìn.</h1>
    </div>
    <div class="dashboard-spotlight-pulse">
        <span class="dashboard-spotlight-dot"></span>
        Dữ liệu vận hành
    </div>
</section>

<div class="row g-3 mb-3">
    @foreach (var kpi in Model.Kpis)
    {
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card app-kpi-card h-100">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small">@kpi.Title</div>
                        <div class="fs-4 fw-semibold mt-1">@kpi.ValueText</div>
                        <div class="small mt-2">
                            @if (kpi.IsDeltaPositive)
                            {
                                <span class="text-success">@kpi.DeltaText</span>
                            }
                            else
                            {
                                <span class="text-danger">@kpi.DeltaText</span>
                            }
                        </div>
                    </div>
                    <div class="app-kpi-icon app-kpi-icon--@kpi.Theme rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi @kpi.Icon"></i>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-mini-stat h-100">
            <div class="card-body">
                <div class="text-secondary small">Giải ngân năm @Model.SelectedYear</div>
                <div class="fs-5 fw-semibold mt-1">@Model.Totals.DisbursedThisYearText</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-mini-stat h-100">
            <div class="card-body">
                <div class="text-secondary small">Thu nợ tháng này</div>
                <div class="fs-5 fw-semibold mt-1">@Model.Totals.CollectedThisMonthText</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-mini-stat h-100">
            <div class="card-body">
                <div class="text-secondary small">Kỳ trả nợ quá hạn</div>
                <div class="fs-5 fw-semibold mt-1">@Model.Totals.OverdueScheduleCount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card app-mini-stat h-100">
            <div class="card-body">
                <div class="text-secondary small">Khách hàng đang hoạt động</div>
                <div class="fs-5 fw-semibold mt-1">@Model.Totals.ActiveCustomerCount.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold">So sánh Giải ngân theo tháng</div>
                    <form method="get">
                        <select name="year" class="form-select form-select-sm" style="width: 130px" aria-label="Chọn năm" onchange="this.form.submit()">
                            @foreach (var y in Model.AvailableYears)
                            {
                                if (y == Model.SelectedYear)
                                {
                                    <option value="@y" selected>@("Năm " + y)</option>
                                }
                                else
                                {
                                    <option value="@y">@("Năm " + y)</option>
                                }
                            }
                        </select>
                    </form>
                </div>

                <div class="app-chart-wrap">
                    <canvas id="disbursementChart" height="110"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold">Đơn vay mới nhất</div>
                    <a class="text-decoration-none" asp-controller="Loan" asp-action="Index">Xem tất cả</a>
                </div>

                <div class="list-group list-group-flush">
                    @if (Model.LatestLoans.Count == 0)
                    {
                        <div class="text-secondary small">Chưa có đơn vay nào.</div>
                    }
                    else
                    {
                        foreach (var item in Model.LatestLoans)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="me-2">
                                        <div class="fw-semibold">@item.CustomerName</div>
                                        <div class="text-secondary small">@item.Code</div>
                                    </div>
                                    <span class="badge rounded-pill text-bg-@item.StatusKind">@item.StatusText</span>
                                </div>
                                <div class="text-secondary small mt-1">@item.AmountText</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fw-semibold mb-3">Cơ cấu khoản vay</div>

                @if (Model.LoanStatusSummary.Count == 0)
                {
                    <div class="text-secondary small">Chưa có khoản vay nào.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.LoanStatusSummary)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge rounded-pill text-bg-@item.StatusKind">@item.StatusText</span>
                                    <span class="fw-semibold">@item.Count.ToString("N0")</span>
                                </div>
                                <div class="text-secondary small mt-1">Dư nợ còn lại: @item.OutstandingText</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold">Lịch trả nợ quá hạn</div>
                    <a class="text-decoration-none" asp-controller="Debt" asp-action="Index">Xem nợ</a>
                </div>

                @if (Model.OverdueSchedules.Count == 0)
                {
                    <div class="text-secondary small">Không có kỳ trả nợ quá hạn.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.OverdueSchedules)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold">@item.CustomerName</div>
                                        <div class="text-secondary small">@item.LoanCode - hạn @item.DueDateText</div>
                                    </div>
                                    <span class="badge text-bg-danger">@item.DaysOverdue ngày</span>
                                </div>
                                <div class="text-secondary small mt-1">@item.AmountText</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fw-semibold mb-3">Thanh toán gần đây</div>

                @if (Model.RecentPayments.Count == 0)
                {
                    <div class="text-secondary small">Chưa có giao dịch thanh toán.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.RecentPayments)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold">@item.CustomerName</div>
                                        <div class="text-secondary small">@item.LoanCode - @item.PaidDateText</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-semibold">@item.AmountText</div>
                                        <div class="text-secondary small">@item.Method</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const el = document.getElementById('disbursementChart');
            if (!el) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DisbursementMonthLabels));
            const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DisbursementValues));

            new Chart(el, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Giải ngân',
                        data,
                        tension: 0.35,
                        borderWidth: 2,
                        pointRadius: 2,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: true }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.06)' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        })();
    </script>
}
